[Unit]
Description=secretd - secrets that agents can use but not see
After=network-online.target
Wants=network-online.target

[Service]
User=devsecrets
Group=devsecrets
ExecStart=/usr/local/bin/secretd --config /etc/secretd/config.json
# systemd decrypts the master key (host key + TPM) and gives it only to this service.
LoadCredentialEncrypted=master:/etc/secretd/master.cred
RuntimeDirectory=secretd
RuntimeDirectoryMode=0755
StateDirectory=secretd
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=2

# Hardening
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
